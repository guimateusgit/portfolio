# ----------------------------------------------------------------------------
# Copie este arquivo para ".env.local" e preencha os valores.
# ----------------------------------------------------------------------------

# Chave da API do Resend (https://resend.com/api-keys) — gratuito até 3.000 e-mails/mês
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remetente. Enquanto você não verificar um domínio próprio no Resend,
# use exatamente "Portfolio <onboarding@resend.dev>".
# Depois de verificar seu domínio: "Portfolio <contato@seudominio.com>"
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Para onde os leads são enviados
CONTACT_TO_EMAIL=mateussadev@gmail.com

# URL pública do site (usada em SEO, sitemap e OpenGraph)
NEXT_PUBLIC_SITE_URL=https://mateusguimaraes.dev

# ----------------------------------------------------------------------------
# OPCIONAL — seção "Atividade no GitHub"
# ----------------------------------------------------------------------------
# A seção funciona SEM token: repositórios, stars e linguagens vêm da API
# pública. O token só habilita o número de "contribuições nos últimos 12 meses"
# (que só existe na API GraphQL) e sobe o limite de requisições de 60 para
# 5.000 por hora.
#
# Para gerar: github.com/settings/tokens → "Generate new token (classic)"
# → NÃO marque nenhum escopo (dados públicos bastam) → copie e cole abaixo.
GITHUB_TOKEN=
